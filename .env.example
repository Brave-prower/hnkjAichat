# =====================================================
# Docker Compose 环境变量模板
#
# 用途：给 docker compose 读取（放在项目根目录）。
#       本地开发模式请改用 backend/.env.example
#
# 用法：复制本文件为 .env，填入你的 Key，然后 docker compose up -d --build
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，不会被提交，可放心填真实 Key
# =====================================================

# ---------- 生成回答：DeepSeek（必需）----------
# 申请地址：https://platform.deepseek.com
# 不填的后果：每次提问都会降级为「返回制度原文」，不会有 AI 生成的回答
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 官方现役模型：deepseek-flash（推荐，快）/ deepseek-v4-pro（更强，慢）
DEEPSEEK_MODEL=deepseek-flash

# ---------- 文本向量化：硅基流动（可选）----------
# 申请地址：https://cloud.siliconflow.cn （需实名认证，未认证的 Key 会 401）
# bge-m3 模型免费
# 不填的后果：系统自动降级为「中文关键词检索」，问答仍可用，但语义匹配精度下降
OPENAI_API_KEY=
# ⚠️ 重要：不要带 /v1，Spring AI 会自己拼接 /v1/embeddings
OPENAI_BASE_URL=https://api.siliconflow.cn
AI_EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 数据库（一般无需修改）----------
# 这些是容器内部连接参数，docker-compose.yml 已写好默认值
# 如需连外部数据库再取消注释
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=campus_qa
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# ---------- 运行环境 ----------
# local    = 普通表 + Java 余弦检索（默认，无需 pgvector 扩展，任何 PG 都能跑）
# railway  = Spring AI PgVectorStore + HNSW 索引
SPRING_PROFILES_ACTIVE=local
