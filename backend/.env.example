# ============================================================
# 校园规章制度智能问答系统 —— 后端环境变量模板
# 复制本文件为 .env（或直接在系统环境变量中设置），填入你自己的 Key。
# ⚠️ 任何真实 Key 都不要提交到 Git！
# ============================================================

# ---------- 1. 数据库（PostgreSQL，必填） ----------
# 本地开发可用 docker compose up -d 一键启动，默认值即可
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_qa
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------- 2. DeepSeek（生成回答，必填） ----------
# 申请地址：https://platform.deepseek.com  → API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型名（官方现役：deepseek-flash 推荐 / deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-flash
# 官方接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 3. Embedding（向量化，必填） ----------
# 任何兼容 OpenAI 协议的服务均可。国内推荐硅基流动（SiliconFlow）：
#   申请地址：https://cloud.siliconflow.cn  → API 密钥（需实名认证）
#   BAAI/bge-m3 为免费嵌入模型，输出 1024 维向量
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ⚠️ 注意：不要带 /v1 后缀！Spring AI 会自动拼接 /v1/embeddings
OPENAI_BASE_URL=https://api.siliconflow.cn
AI_EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 4. 可选配置（有默认值，一般不用改） ----------
# 运行模式：local = 普通表 + Java 余弦检索（免 pgvector 扩展）
#          railway = pgvector + HNSW 索引（生产/云部署）
# SPRING_PROFILES_ACTIVE=local
# 服务端口
# SERVER_PORT=8080
# 检索条数与相似度阈值
# QA_TOP_K=3
# QA_SIMILARITY_THRESHOLD=0.6
